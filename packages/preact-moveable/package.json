{
    "name": "preact-moveable",
    "version": "0.55.0",
    "description": "A Preact Component that create Moveable, Draggable, Resizable, Scalable, Rotatable, Pinchable, Groupable, Snappable.",
    "main": "./dist/moveable.cjs.js",
    "module": "./dist/moveable.esm.js",
    "sideEffects": false,
    "types": "declaration/index.d.ts",
    "scripts": {
        "build": "tsdown && pnpm run declaration",
        "declaration": "rm -rf declaration && tsc -p tsconfig.declaration.json"
    },
    "files": [
        "./*",
        "src/*",
        "dist/*",
        "declaration/*"
    ],
    "keywords": [
        "moveable",
        "resizable",
        "scalable",
        "draggable",
        "rotatable",
        "groupable",
        "movable",
        "warpable",
        "pinchable",
        "snappable",
        "throttle",
        "ratio",
        "dom",
        "resize",
        "scale",
        "drag",
        "move",
        "rotate",
        "warp",
        "preact",
        "pinch",
        "snap"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/daybrush/moveable/blob/master/packages/preact-moveable"
    },
    "author": "Daybrush",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/daybrush/moveable/issues"
    },
    "homepage": "https://daybrush.com/moveable",
    "devDependencies": {
        "keycon": "^0.3.0",
        "preact": "^10.0.0",
        "tsdown": "~0.23.1",
        "typescript": "~6.0.3"
    },
    "dependencies": {
        "@daybrush/utils": "^1.13.0",
        "@egjs/agent": "^2.2.1",
        "@egjs/children-differ": "^1.0.1",
        "@egjs/list-differ": "^1.0.0",
        "@scena/dragscroll": "^1.4.0",
        "@scena/event-emitter": "^1.0.5",
        "@scena/matrix": "^1.1.1",
        "css-to-mat": "^1.1.1",
        "framework-utils": "^1.1.0",
        "gesto": "^1.19.3",
        "overlap-area": "^1.1.0",
        "preact-css-styled": "^1.1.9",
        "react-moveable": "workspace:~"
    }
}
