{
    "name": "@moveable-next/croact",
    "version": "0.1.1",
    "description": "A React Compat Component that create Moveable, Draggable, Resizable, Scalable, Rotatable, Pinchable, Groupable, Snappable.",
    "main": "./dist/moveable.cjs.js",
    "module": "./dist/moveable.esm.js",
    "sideEffects": false,
    "types": "declaration/index.d.ts",
    "exports": {
        ".": {
            "types": "./declaration/index.d.ts",
            "module": "./dist/moveable.esm.js",
            "default": "./dist/moveable.cjs.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown && pnpm run declaration",
        "declaration": "rm -rf declaration && tsc -p tsconfig.declaration.json"
    },
    "keywords": [
        "moveable",
        "resizable",
        "scalable",
        "draggable",
        "rotatable",
        "groupable",
        "movable",
        "warpable",
        "pinchable",
        "snappable",
        "throttle",
        "ratio",
        "dom",
        "resize",
        "scale",
        "drag",
        "move",
        "rotate",
        "warp",
        "react",
        "pinch",
        "snap",
        "compat"
    ],
    "files": [
        "dist",
        "declaration",
        "src"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/colinli007/moveable-next.git",
        "directory": "packages/croact-moveable"
    },
    "author": "Daybrush",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/colinli007/moveable-next/issues"
    },
    "homepage": "https://github.com/colinli007/moveable-next/tree/main/packages/croact-moveable#readme",
    "devDependencies": {
        "@types/react": "catalog:",
        "croact": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "croact": "^1.0.4"
    },
    "dependencies": {
        "@daybrush/utils": "catalog:",
        "@egjs/agent": "catalog:",
        "@egjs/children-differ": "catalog:",
        "@egjs/list-differ": "catalog:",
        "@moveable-next/react": "workspace:~",
        "@scena/dragscroll": "catalog:",
        "@scena/event-emitter": "catalog:",
        "@scena/matrix": "catalog:",
        "croact-css-styled": "^1.1.9",
        "css-to-mat": "catalog:",
        "framework-utils": "catalog:",
        "gesto": "catalog:",
        "overlap-area": "catalog:"
    }
}
