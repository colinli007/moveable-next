{
    "name": "croact-moveable",
    "version": "0.9.0",
    "description": "A React Compat Component that create Moveable, Draggable, Resizable, Scalable, Rotatable, Pinchable, Groupable, Snappable.",
    "main": "./dist/moveable.cjs.js",
    "module": "./dist/moveable.esm.js",
    "sideEffects": false,
    "types": "declaration/index.d.ts",
    "scripts": {
        "build": "tsdown && pnpm run declaration",
        "declaration": "rm -rf declaration && tsc -p tsconfig.declaration.json"
    },
    "keywords": [
        "moveable",
        "resizable",
        "scalable",
        "draggable",
        "rotatable",
        "groupable",
        "movable",
        "warpable",
        "pinchable",
        "snappable",
        "throttle",
        "ratio",
        "dom",
        "resize",
        "scale",
        "drag",
        "move",
        "rotate",
        "warp",
        "react",
        "pinch",
        "snap",
        "compat"
    ],
    "files": [
        "./*",
        "src/*",
        "dist/*",
        "declaration/*"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/daybrush/moveable/blob/master/packages/croact-moveable"
    },
    "author": "Daybrush",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/daybrush/moveable/issues"
    },
    "homepage": "https://daybrush.com/moveable",
    "devDependencies": {
        "@types/react": "catalog:",
        "croact": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "croact": "^1.0.4"
    },
    "dependencies": {
        "@daybrush/utils": "catalog:",
        "@egjs/agent": "catalog:",
        "@egjs/children-differ": "catalog:",
        "@egjs/list-differ": "catalog:",
        "@scena/dragscroll": "catalog:",
        "@scena/event-emitter": "catalog:",
        "@scena/matrix": "catalog:",
        "croact-css-styled": "^1.1.9",
        "css-to-mat": "catalog:",
        "framework-utils": "catalog:",
        "gesto": "catalog:",
        "overlap-area": "catalog:",
        "react-moveable": "workspace:~"
    }
}
