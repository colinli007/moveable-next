{
  "compilerOptions": {
    "outDir": "./outjs/",
    "sourceMap": true,
    "module": "esnext",
    "target": "es2022",
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
  },
  "include": [
    "./src/**/*.ts"
  ]
}