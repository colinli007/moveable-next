{
  "extends": "./tsconfig",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": false,
    "isolatedModules": false,
    "removeComments": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "declarationDir": "declaration"
  },
  "include": [
    "./src/**/*"
  ]
}
