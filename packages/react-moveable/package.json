{
    "name": "react-moveable",
    "version": "0.56.0",
    "description": "A React Component that create Moveable, Draggable, Resizable, Scalable, Rotatable, Warpable, Pinchable, Groupable.",
    "main": "./dist/moveable.cjs.js",
    "module": "./dist/moveable.esm.js",
    "sideEffects": false,
    "types": "declaration/index.d.ts",
    "files": [
        "./*",
        "src/*",
        "dist/*",
        "declaration/*",
        "types/*"
    ],
    "scripts": {
        "lint": "eslint ./src/ --ext .ts,.tsx",
        "storybook": "pnpm bake && storybook dev -p 6006",
        "bake": "bake",
        "test": "pnpm bake && vitest run",
        "test:type": "tsc -p tsconfig.test.json",
        "build": "pnpm run lint && pnpm run test:type && rollup -c && pnpm run declaration && print-sizes ./dist",
        "build:storybook": "pnpm bake && storybook build -o ../../demo/storybook",
        "declaration": "rm -rf declaration && tsc -p tsconfig.declaration.json",
        "typecheck:stories": "tsc -p stories"
    },
    "keywords": [
        "moveable",
        "resizable",
        "scalable",
        "draggable",
        "rotatable",
        "warpable",
        "pinchable",
        "groupable",
        "snappable",
        "scrollable",
        "movable",
        "throttle",
        "scroll",
        "ratio",
        "dom",
        "resize",
        "scale",
        "drag",
        "move",
        "rotate",
        "react",
        "warp",
        "snap",
        "pinch",
        "react"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/daybrush/moveable/blob/master/packages/react-moveable"
    },
    "author": "Daybrush",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/daybrush/moveable/issues"
    },
    "homepage": "https://daybrush.com/moveable",
    "devDependencies": {
        "@babel/core": "^7.7.2",
        "@croffle/bakery": "^0.0.25",
        "@daybrush/builder": "^0.2.4",
        "@scena/react-guides": "^0.28.2",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/addon-vitest": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@types/node": "^22.20.5",
        "@types/react": "^16.9.17",
        "@types/react-dom": "^16.9.4",
        "@typescript-eslint/eslint-plugin": "^5.60.1",
        "@typescript-eslint/parser": "^5.60.1",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/browser-playwright": "5.0.3",
        "croffle": "^0.0.21",
        "eslint": "^7.7.0",
        "eslint-plugin-import": "^2.22.1",
        "eslint-plugin-react": "^7.22.0",
        "gh-pages": "^2.1.1",
        "keycon": "^1.4.0",
        "playwright": "^1.64.0",
        "print-sizes": "^0.2.0",
        "pvu": "^0.6.1",
        "react": "^16.8.6",
        "react-dom": "^16.8.6",
        "react-infinite-viewer": "^0.28.1",
        "react-keycon": "^0.3.0",
        "rollup": "~3.25.3",
        "storybook": "^10.6.1",
        "storybook-dark-mode": "^5.0.0",
        "tslib": "^2.3.1",
        "typescript": "~5.9.3",
        "vite": "^8.3.4",
        "vitest": "5.0.3"
    },
    "dependencies": {
        "@daybrush/utils": "^1.13.0",
        "@egjs/agent": "^2.2.1",
        "@egjs/children-differ": "^1.0.1",
        "@egjs/list-differ": "^1.0.0",
        "@scena/dragscroll": "^1.4.0",
        "@scena/event-emitter": "^1.0.5",
        "@scena/matrix": "^1.1.1",
        "css-to-mat": "^1.1.1",
        "framework-utils": "^1.1.0",
        "gesto": "^1.19.3",
        "overlap-area": "^1.1.0",
        "react-css-styled": "^1.1.9",
        "react-selecto": "^1.25.0"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
