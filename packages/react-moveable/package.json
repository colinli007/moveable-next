{
    "name": "@moveable-next/react",
    "version": "0.1.0",
    "description": "A React Component that create Moveable, Draggable, Resizable, Scalable, Rotatable, Warpable, Pinchable, Groupable.",
    "main": "./dist/moveable.cjs.js",
    "module": "./dist/moveable.esm.js",
    "sideEffects": false,
    "types": "declaration/index.d.ts",
    "exports": {
        ".": {
            "types": "./declaration/index.d.ts",
            "module": "./dist/moveable.esm.js",
            "default": "./dist/moveable.cjs.js"
        },
        "./types": {
            "types": "./declaration/externalTypes.d.ts",
            "default": "./types/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "declaration",
        "src",
        "types"
    ],
    "scripts": {
        "storybook": "storybook dev -p 6006",
        "test": "vitest run",
        "test:type": "tsc -p tsconfig.test.json",
        "build": "pnpm run test:type && tsdown && pnpm run declaration",
        "build:storybook": "storybook build -o ../../demo/storybook",
        "declaration": "rm -rf declaration && tsc -p tsconfig.declaration.json",
        "typecheck:stories": "tsc -p stories"
    },
    "keywords": [
        "moveable",
        "resizable",
        "scalable",
        "draggable",
        "rotatable",
        "warpable",
        "pinchable",
        "groupable",
        "snappable",
        "scrollable",
        "movable",
        "throttle",
        "scroll",
        "ratio",
        "dom",
        "resize",
        "scale",
        "drag",
        "move",
        "rotate",
        "react",
        "warp",
        "snap",
        "pinch",
        "react"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/colinli007/moveable-next.git",
        "directory": "packages/react-moveable"
    },
    "author": "Daybrush",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/colinli007/moveable-next/issues"
    },
    "homepage": "https://github.com/colinli007/moveable-next/tree/main/packages/react-moveable#readme",
    "devDependencies": {
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/addon-vitest": "^10.6.2",
        "@storybook/react-vite": "^10.6.2",
        "@types/node": "^22.20.5",
        "@types/react": "catalog:",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/browser-playwright": "catalog:",
        "keycon": "^1.4.0",
        "playwright": "catalog:",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-infinite-viewer": "^0.28.1",
        "react-keycon": "^0.3.0",
        "storybook": "^10.6.2",
        "storybook-dark-mode": "^5.0.0",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vite": "^8.3.4",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "dependencies": {
        "@daybrush/utils": "catalog:",
        "@egjs/agent": "catalog:",
        "@egjs/children-differ": "catalog:",
        "@egjs/list-differ": "catalog:",
        "@scena/dragscroll": "catalog:",
        "@scena/event-emitter": "catalog:",
        "@scena/matrix": "catalog:",
        "css-to-mat": "catalog:",
        "framework-utils": "catalog:",
        "gesto": "catalog:",
        "overlap-area": "catalog:",
        "react-css-styled": "^1.1.9",
        "react-selecto": "^1.26.3"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
