{
    "name": "react-moveable",
    "version": "0.56.0",
    "description": "A React Component that create Moveable, Draggable, Resizable, Scalable, Rotatable, Warpable, Pinchable, Groupable.",
    "main": "./dist/moveable.cjs.js",
    "module": "./dist/moveable.esm.js",
    "sideEffects": false,
    "types": "declaration/index.d.ts",
    "files": [
        "./*",
        "src/*",
        "dist/*",
        "declaration/*",
        "types/*"
    ],
    "scripts": {
        "storybook": "pnpm bake && storybook dev -p 6006",
        "bake": "bake",
        "test": "pnpm bake && vitest run",
        "test:type": "tsc -p tsconfig.test.json",
        "build": "pnpm run test:type && tsdown && pnpm run declaration",
        "build:storybook": "pnpm bake && storybook build -o ../../demo/storybook",
        "declaration": "rm -rf declaration && tsc -p tsconfig.declaration.json",
        "typecheck:stories": "tsc -p stories"
    },
    "keywords": [
        "moveable",
        "resizable",
        "scalable",
        "draggable",
        "rotatable",
        "warpable",
        "pinchable",
        "groupable",
        "snappable",
        "scrollable",
        "movable",
        "throttle",
        "scroll",
        "ratio",
        "dom",
        "resize",
        "scale",
        "drag",
        "move",
        "rotate",
        "react",
        "warp",
        "snap",
        "pinch",
        "react"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/daybrush/moveable/blob/master/packages/react-moveable"
    },
    "author": "Daybrush",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/daybrush/moveable/issues"
    },
    "homepage": "https://daybrush.com/moveable",
    "devDependencies": {
        "@croffle/bakery": "^0.0.25",
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/addon-vitest": "^10.6.2",
        "@storybook/react-vite": "^10.6.2",
        "@types/node": "^22.20.5",
        "@types/react": "catalog:",
        "@types/react-dom": "^16.9.25",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/browser-playwright": "catalog:",
        "croffle": "^0.0.21",
        "keycon": "^1.4.0",
        "playwright": "catalog:",
        "react": "^16.14.0",
        "react-dom": "^16.14.0",
        "react-infinite-viewer": "^0.28.1",
        "react-keycon": "^0.3.0",
        "storybook": "^10.6.2",
        "storybook-dark-mode": "^5.0.0",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@daybrush/utils": "catalog:",
        "@egjs/agent": "catalog:",
        "@egjs/children-differ": "catalog:",
        "@egjs/list-differ": "catalog:",
        "@scena/dragscroll": "catalog:",
        "@scena/event-emitter": "catalog:",
        "@scena/matrix": "catalog:",
        "css-to-mat": "catalog:",
        "framework-utils": "catalog:",
        "gesto": "catalog:",
        "overlap-area": "catalog:",
        "react-css-styled": "^1.1.9",
        "react-selecto": "^1.26.3"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
