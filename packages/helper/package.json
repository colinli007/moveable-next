{
    "name": "@moveable-next/helper",
    "version": "0.1.3",
    "description": "Helper for demo of Moveable",
    "main": "./dist/helper.cjs.js",
    "module": "./dist/helper.esm.js",
    "sideEffects": false,
    "types": "declaration/index.d.ts",
    "exports": {
        ".": {
            "types": "./declaration/index.d.ts",
            "module": "./dist/helper.esm.js",
            "default": "./dist/helper.cjs.js"
        },
        "./dist/helper.js": "./dist/helper.js",
        "./dist/helper.min.js": "./dist/helper.min.js",
        "./package.json": "./package.json"
    },
    "unpkg": "./dist/helper.min.js",
    "jsdelivr": "./dist/helper.min.js",
    "files": [
        "dist",
        "declaration",
        "src"
    ],
    "scripts": {
        "start": "tsdown --watch",
        "build": "tsdown && pnpm run declaration",
        "declaration": "rm -rf declaration && tsc -p tsconfig.declaration.json",
        "test": "vitest run"
    },
    "keywords": [
        "moveable",
        "resizable",
        "scalable",
        "draggable",
        "rotatable",
        "warpable",
        "pinchable",
        "groupable",
        "snappable",
        "scrollable",
        "movable",
        "throttle",
        "scroll",
        "ratio",
        "dom",
        "resize",
        "scale",
        "drag",
        "move",
        "rotate",
        "react",
        "warp",
        "snap",
        "pinch"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/colinli007/moveable-next.git",
        "directory": "packages/helper"
    },
    "author": "Daybrush",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/colinli007/moveable-next/issues"
    },
    "homepage": "https://github.com/colinli007/moveable-next/tree/main/packages/helper#readme",
    "devDependencies": {
        "happy-dom": "^21.0.1",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@daybrush/utils": "catalog:"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
