{
    "name": "vue3-moveable",
    "version": "0.28.0",
    "description": "A Vue 3 Component that create Moveable, Draggable, Resizable, Scalable, Rotatable, Warpable, Pinchable, Groupable.",
    "types": "declaration/index.d.ts",
    "main": "dist/moveable.cjs.js",
    "module": "dist/moveable.esm.js",
    "sideEffects": false,
    "scripts": {
        "build": "tsdown && pnpm run declaration && pnpm run test:type",
        "declaration": "rm -rf declaration && tsc -p tsconfig.declaration.json",
        "test": "vitest run",
        "test:type": "tsc -p tsconfig.test.json"
    },
    "keywords": [
        "moveable",
        "resizable",
        "scalable",
        "draggable",
        "rotatable",
        "warpable",
        "pinchable",
        "groupable",
        "snappable",
        "scrollable",
        "movable",
        "throttle",
        "scroll",
        "ratio",
        "dom",
        "resize",
        "scale",
        "drag",
        "move",
        "rotate",
        "vue",
        "warp",
        "snap",
        "pinch"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/daybrush/moveable/blob/master/packages/vue3-moveable"
    },
    "author": "Daybrush",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/daybrush/moveable/issues"
    },
    "homepage": "https://daybrush.com/moveable",
    "dependencies": {
        "@daybrush/utils": "catalog:",
        "moveable": "workspace:~"
    },
    "files": [
        "./*",
        "src/*",
        "dist/*",
        "declaration/*"
    ],
    "devDependencies": {
        "@vitest/browser-playwright": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vue": "^3.5.44"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    }
}
