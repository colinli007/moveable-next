{
    "name": "@moveable-next/vue3",
    "version": "0.1.2",
    "description": "A Vue 3 Component that create Moveable, Draggable, Resizable, Scalable, Rotatable, Warpable, Pinchable, Groupable.",
    "types": "declaration/index.d.ts",
    "exports": {
        ".": {
            "types": "./declaration/index.d.ts",
            "module": "./dist/moveable.esm.js",
            "default": "./dist/moveable.cjs.js"
        },
        "./package.json": "./package.json"
    },
    "main": "dist/moveable.cjs.js",
    "module": "dist/moveable.esm.js",
    "sideEffects": false,
    "scripts": {
        "build": "tsdown && pnpm run declaration && pnpm run test:type && pnpm run test:tree-shaking",
        "declaration": "rm -rf declaration && tsc -p tsconfig.declaration.json",
        "test": "vitest run",
        "test:type": "tsc -p tsconfig.test.json",
        "test:tree-shaking": "node ../../config/check-tree-shaking.mjs"
    },
    "keywords": [
        "moveable",
        "resizable",
        "scalable",
        "draggable",
        "rotatable",
        "warpable",
        "pinchable",
        "groupable",
        "snappable",
        "scrollable",
        "movable",
        "throttle",
        "scroll",
        "ratio",
        "dom",
        "resize",
        "scale",
        "drag",
        "move",
        "rotate",
        "vue",
        "warp",
        "snap",
        "pinch"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/colinli007/moveable-next.git",
        "directory": "packages/vue3-moveable"
    },
    "author": "Daybrush",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/colinli007/moveable-next/issues"
    },
    "homepage": "https://github.com/colinli007/moveable-next/tree/main/packages/vue3-moveable#readme",
    "dependencies": {
        "@daybrush/utils": "catalog:",
        "@moveable-next/vanilla": "workspace:~"
    },
    "files": [
        "dist",
        "declaration",
        "src"
    ],
    "devDependencies": {
        "@vitest/browser-playwright": "catalog:",
        "playwright": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vue": "catalog:"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    }
}
